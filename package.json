{
  "name": "bolomobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.7",
    "expo-asset": "~57.0.3",
    "expo-audio": "~57.0.2",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-notifications": "~57.0.6",
    "expo-router": "~57.0.7",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "expo-widgets": "~57.0.6",
    "lucide-react-native": "^1.24.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webrtc": "^124.0.7",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "e2e:validate": "node ./scripts/validate-e2e-flows.mjs",
    "e2e:ios": "maestro test .maestro",
    "store:validate": "node ./scripts/validate-store-assets.mjs",
    "acceptance:live": "node ./scripts/validate-live-services.mjs",
    "build:android:preview": "node ./scripts/run-eas-from-app-root.mjs build --platform android --profile preview",
    "build:ios:preview": "node ./scripts/run-eas-from-app-root.mjs build --platform ios --profile preview",
    "build:production": "npm run release:validate && node ./scripts/run-eas-from-app-root.mjs build --platform all --profile production",
    "build:ios:production": "npm run release:validate && node ./scripts/run-eas-from-app-root.mjs build --platform ios --profile production",
    "submit:android:internal": "npm run release:validate && node ./scripts/run-eas-from-app-root.mjs submit --platform android --latest --profile internal",
    "submit:android:production": "npm run release:validate && node ./scripts/run-eas-from-app-root.mjs submit --platform android --latest --profile production",
    "submit:ios:production": "npm run release:validate && node ./scripts/run-eas-from-app-root.mjs submit --platform ios --latest --profile production",
    "metadata:push": "npm run release:validate && node ./scripts/run-eas-from-app-root.mjs metadata:push --profile production",
    "release:validate": "node ./scripts/validate-release.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run store:validate && npm run e2e:validate"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-worklets/jest/resolver.js",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/src/app/"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-webrtc"
        ],
        "listUnknownPackages": true
      }
    }
  },
  "private": true
}
