{
  "name": "bolomobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "57.0.22",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.27",
    "expo-asset": "57.0.19",
    "expo-audio": "57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "57.0.21",
    "expo-crypto": "57.0.3",
    "expo-device": "57.0.2",
    "expo-document-picker": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-glass-effect": "57.0.4",
    "expo-haptics": "57.0.3",
    "expo-image": "57.0.5",
    "expo-linking": "57.0.12",
    "expo-notifications": "57.0.22",
    "expo-router": "57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "57.0.22",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "57.0.3",
    "expo-system-ui": "57.0.4",
    "expo-web-browser": "57.0.3",
    "expo-widgets": "57.0.23",
    "heroui-native": "1.0.11",
    "lucide-react-native": "^1.61.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webrtc": "^155.0.1",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "uniwind": "1.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "expo-dev-client": "57.0.19",
    "expo-doctor": "1.20.2",
    "jest": "~29.7.0",
    "jest-expo": "57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "e2e:validate": "node ./scripts/validate-e2e-flows.mjs",
    "e2e:ios": "maestro test .maestro/flows/00-ci-smoke.yaml",
    "store:validate": "node ./scripts/validate-store-assets.mjs",
    "store:validate:ios": "node ./scripts/validate-store-assets.mjs --platform ios",
    "acceptance:live": "node ./scripts/validate-live-services.mjs",
    "audit:gate": "node ./scripts/assert-audit-exceptions.mjs",
    "toolchain:check": "node ./scripts/assert-node-version.mjs",
    "build:android:preview": "node ./scripts/run-eas-from-app-root.mjs build --platform android --profile preview",
    "build:ios:preview": "node ./scripts/run-eas-from-app-root.mjs build --platform ios --profile preview",
    "build:production": "npm run release:validate && node ./scripts/run-eas-from-app-root.mjs build --platform all --profile production",
    "build:ios:production": "npm run release:preflight:ios:binary && node ./scripts/run-eas-from-app-root.mjs build --platform ios --profile production",
    "submit:android:internal": "npm run release:validate && node ./scripts/run-eas-from-app-root.mjs submit --platform android --latest --profile internal",
    "submit:android:production": "npm run release:validate && node ./scripts/run-eas-from-app-root.mjs submit --platform android --latest --profile production",
    "submit:ios:production": "npm run release:preflight:ios:binary && node ./scripts/run-eas-from-app-root.mjs submit --platform ios --latest --profile production",
    "metadata:push": "npm run release:validate && node ./scripts/run-eas-from-app-root.mjs metadata:push --profile production",
    "metadata:ios:push": "npm run release:preflight:ios && node ./scripts/run-eas-from-app-root.mjs metadata:push --profile production",
    "release:provenance": "node ./scripts/assert-release-provenance.mjs",
    "release:validate": "npm run production:validate && node ./scripts/validate-release.mjs",
    "release:validate:ios": "npm run production:validate && node ./scripts/validate-release.mjs --platform ios",
    "release:validate:ios:binary": "npm run production:validate && node ./scripts/validate-release.mjs --platform ios --phase binary",
    "release:validate:live": "node ./scripts/validate-release-live.mjs",
    "release:preflight": "npm run release:provenance && npm run audit:gate && npm run release:validate && npm run release:validate:live",
    "release:preflight:ios": "npm run toolchain:check && npm run release:provenance && npm run verify && npm run audit:gate && npm run release:validate:ios && npm run store:validate:ios",
    "release:preflight:ios:binary": "npm run toolchain:check && npm run release:provenance && npm run verify && npm run audit:gate && npm run release:validate:ios:binary && npm run store:validate:ios",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run store:validate && npm run e2e:validate && npm run production:validate",
    "production:validate": "node ./scripts/validate-production-config.mjs",
    "native:validate": "node ./scripts/validate-native-project.mjs",
    "security:audit:runtime": "node ./scripts/audit-runtime-dependencies.mjs",
    "postinstall": "node ./scripts/patch-query-string-decoder.mjs"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "bolo-audio-normalizer",
          "react-native-webrtc"
        ],
        "listUnknownPackages": true
      }
    },
    "install": {
      "exclude": [
        "@expo/ui",
        "expo",
        "expo-asset",
        "expo-constants",
        "expo-crypto",
        "expo-linking",
        "expo-notifications",
        "expo-router",
        "expo-sharing",
        "expo-splash-screen",
        "expo-widgets",
        "expo-dev-client",
        "jest-expo"
      ]
    }
  },
  "overrides": {
    "uuid": "^11.1.1",
    "brace-expansion": "^5.0.12",
    "minimatch@^3.0.0": {
      "brace-expansion": "1.1.21"
    },
    "node-forge": "1.4.2",
    "zod": "4.6.7",
    "decode-uri-component": "0.5.1",
    "expo-modules-core": "57.0.21",
    "expo-modules-jsi": "57.1.1",
    "expo-modules-autolinking": "57.0.14",
    "@expo/config-plugins": "57.0.10",
    "@expo/prebuild-config": "57.0.17",
    "babel-preset-expo": "57.0.14",
    "@expo/metro-runtime": "57.0.16",
    "expo-dev-launcher": "57.0.20",
    "expo-dev-menu": "57.0.18",
    "@expo/inline-modules": "0.1.7",
    "expo-constants": "57.0.21"
  },
  "private": true
}
