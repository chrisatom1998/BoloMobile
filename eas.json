{
  "cli": {
    "version": "21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "staging-e2e": {
      "distribution": "internal",
      "environment": "preview",
      "withoutCredentials": true,
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "ios": {
        "metadataPath": "./store.config.js"
      },
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}
